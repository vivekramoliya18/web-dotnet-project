@{
    ViewData["Title"] = "Dashboard";
}
<div class="medicare-dashboard">
    <div class="welcome-banner"><div><span class="welcome-tag">MEDICAL MANAGEMENT SYSTEM</span><h1>Welcome to MediCare</h1><p>Manage doctors, patients, appointments and visits in one place.</p></div><div class="welcome-icon">✚</div></div>
    <div class="stats-grid">
        <div class="stat-card"><div class="stat-icon patients-icon">👥</div><p>Total Patients</p><h2>Manage</h2><span>Registered patient records</span></div>
        <div class="stat-card"><div class="stat-icon appointments-icon">📅</div><p>Appointments</p><h2>Schedule</h2><span>Book and track appointments</span></div>
        <div class="stat-card"><div class="stat-icon doctors-icon">🩺</div><p>Doctors</p><h2>Manage</h2><span>Doctor directory</span></div>
        <div class="stat-card"><div class="stat-icon completed-icon">✓</div><p>Completed Visits</p><h2>Record</h2><span>Diagnosis and visit notes</span></div>
    </div>
    <div class="dashboard-grid">
        <div class="dashboard-panel"><div class="panel-heading"><div><h3>Quick Actions</h3><p>Choose a task to get started</p></div></div>
            <div class="quick-actions">
                <a asp-controller="Patients" asp-action="Create" class="action-card"><span class="action-icon">＋</span><div><strong>Add Patient</strong><p>Register a new patient</p></div><span class="action-arrow">→</span></a>
                <a asp-controller="Appointments" asp-action="Create" class="action-card"><span class="action-icon">▦</span><div><strong>Book Appointment</strong><p>Schedule a patient visit</p></div><span class="action-arrow">→</span></a>
                <a asp-controller="Patients" asp-action="Index" class="action-card"><span class="action-icon">♙</span><div><strong>Manage Patients</strong><p>View patient records</p></div><span class="action-arrow">→</span></a>
                <a asp-controller="Doctors" asp-action="Index" class="action-card"><span class="action-icon">🩺</span><div><strong>Manage Doctors</strong><p>Add and update doctors</p></div><span class="action-arrow">→</span></a>
                <a asp-controller="Appointments" asp-action="Index" class="action-card"><span class="action-icon">✓</span><div><strong>Patient Visits</strong><p>Complete visits and save notes</p></div><span class="action-arrow">→</span></a>
            </div>
        </div>
        <div class="dashboard-panel about-panel"><div class="about-icon">✚</div><h3>Your Clinic, Organised</h3><p>MediCare brings essential clinic workflows together in one simple dashboard.</p><div class="feature-item"><span>✓</span> Patient record management</div><div class="feature-item"><span>✓</span> Doctor directory</div><div class="feature-item"><span>✓</span> Appointment scheduling</div><div class="feature-item"><span>✓</span> Visit completion and notes</div></div>
    </div>
    <div class="dashboard-footer"><span>✚ MediCare Management System</span><span>Better organisation. Better care.</span></div>
</div>
