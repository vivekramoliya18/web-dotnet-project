@model MediCareWeb.Models.Appointment
@{ ViewData["Title"] = "Book Appointment"; }
<div class="container py-4"><div class="row justify-content-center"><div class="col-md-8 col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2>Book Appointment</h2><p class="text-muted">Enter the patient and doctor details to schedule a visit.</p>
<form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="PatientName" class="form-label"></label><input asp-for="PatientName" class="form-control" placeholder="Patient full name"/><span asp-validation-for="PatientName" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="DoctorName" class="form-label"></label><input asp-for="DoctorName" class="form-control" placeholder="Doctor full name"/><span asp-validation-for="DoctorName" class="text-danger"></span></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="AppointmentDate" class="form-label"></label><input asp-for="AppointmentDate" type="date" class="form-control"/><span asp-validation-for="AppointmentDate" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="AppointmentTime" class="form-label"></label><input asp-for="AppointmentTime" type="time" class="form-control"/><span asp-validation-for="AppointmentTime" class="text-danger"></span></div></div>
<div class="mb-4"><label asp-for="Reason" class="form-label"></label><textarea asp-for="Reason" class="form-control" rows="3" placeholder="Reason for appointment"></textarea><span asp-validation-for="Reason" class="text-danger"></span></div>
<button class="btn btn-success">Book Appointment</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
